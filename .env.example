# Server-side secrets only. Never prefix credentials with VITE_.
# Copy to .env (Windows: copy .env.example .env) and fill real values locally.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Optional source discovery. Without this, supply direct official source URLs.
TAVILY_API_KEY=

# Local server ports. Browser code always uses relative /api URLs.
API_PORT=3000
PORT=3000

# Optional conservative rate-limit tuning (per instance, best effort).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
