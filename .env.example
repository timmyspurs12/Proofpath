# Public browser configuration only. Preview mode is used while the contract
# address or qualified node RPC is empty. Never put keys, seeds, tokens, or
# credentialed RPC URLs in any VITE_* variable.
VITE_WEATHERPACT_CONTRACT_ADDRESS=
VITE_GENLAYER_CHAIN_ID=4221
VITE_GENLAYER_CHAIN_NAME=GenLayer Bradbury Testnet

# A qualified GenLayer node RPC that supports gen_* methods and browser CORS.
# The chain-only RPC below is NOT a substitute for this node endpoint.
VITE_GENLAYER_RPC_URL=

# Public chain RPC and explorer used for injected-wallet network configuration.
VITE_GENLAYER_CHAIN_RPC_URL=https://rpc.testnet-chain.genlayer.com
VITE_GENLAYER_EXPLORER_URL=https://scan.testnet-chain.genlayer.com
